{
  "name": "maiarcmiami",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/casas/*", "/zonas/*", "/sitemap.xml"]
  },
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
